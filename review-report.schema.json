{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/jlov7/agent-assurance-case/main/review-report.schema.json",
  "title": "AAC External Review Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "report_type",
    "schema_version",
    "target",
    "reviewer",
    "review",
    "implementation",
    "reproduction",
    "vector_conformance",
    "findings",
    "claim_boundary"
  ],
  "properties": {
    "report_type": { "const": "aac-external-review-report" },
    "schema_version": { "const": "1.0" },
    "target": { "$ref": "#/$defs/target" },
    "reviewer": { "$ref": "#/$defs/reviewer" },
    "review": { "$ref": "#/$defs/review" },
    "implementation": { "$ref": "#/$defs/implementation" },
    "reproduction": { "$ref": "#/$defs/reproduction" },
    "vector_conformance": { "$ref": "#/$defs/vector_conformance" },
    "findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/finding" }
    },
    "claim_boundary": { "$ref": "#/$defs/claim_boundary" }
  },
  "$defs": {
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["release", "commit", "doi"],
      "properties": {
        "release": { "const": "v0.2-candidate.8" },
        "commit": { "const": "689198d9c249a966a0abab6415ae8668efb512d9" },
        "doi": { "const": "10.5281/zenodo.20379393" }
      }
    },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "affiliation_or_project", "contact_or_url"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "affiliation_or_project": { "type": "string", "minLength": 1 },
        "contact_or_url": { "type": "string", "minLength": 1 }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["review_type", "summary", "outcome", "public_artifact_url", "security_sensitive"],
      "properties": {
        "review_type": {
          "enum": [
            "independent-verifier-or-parser",
            "canonicalization-or-signature-vectors",
            "spec-conformance",
            "schema-profile-verifier-consistency",
            "evidence-binding",
            "privacy-or-evidence-references",
            "threat-model-or-limitations",
            "deployment-feedback"
          ]
        },
        "summary": { "type": "string", "minLength": 1 },
        "outcome": {
          "enum": [
            "confirmation",
            "defect",
            "limitation",
            "implementation-divergence",
            "documentation-clarification",
            "inconclusive"
          ]
        },
        "public_artifact_url": { "type": "string" },
        "security_sensitive": { "type": "boolean" }
      }
    },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "applicable",
        "name",
        "source_url",
        "version_or_commit",
        "language_runtime",
        "support_scope",
        "profiles_supported",
        "notes"
      ],
      "properties": {
        "applicable": { "type": "boolean" },
        "name": { "type": "string" },
        "source_url": { "type": "string" },
        "version_or_commit": { "type": "string" },
        "language_runtime": { "type": "string" },
        "support_scope": {
          "enum": [
            "aac.core parser only",
            "aac.core verifier",
            "aac.core verifier plus profiles",
            "canonicalization/signature vectors only",
            "exploratory or partial implementation",
            "not-applicable"
          ]
        },
        "profiles_supported": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "notes": { "type": "string" }
      }
    },
    "reproduction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["environment", "commands", "observed_output"],
      "properties": {
        "environment": { "type": "string", "minLength": 1 },
        "commands": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "observed_output": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "vector_conformance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["applicable", "method", "expected_vector_output", "observed_vector_output"],
      "properties": {
        "applicable": { "type": "boolean" },
        "method": {
          "enum": [
            "reference-check-vectors",
            "independent-implementation",
            "not-applicable"
          ]
        },
        "expected_vector_output": {
          "type": "array",
          "prefixItems": [
            { "const": "AAC vectors: canonicalization accept=6 reject=5" },
            { "const": "AAC vectors: sign_verify=aac-v0.2-demo-sign-verify-pass-with-coverage" },
            { "const": "AAC vectors: valid" }
          ],
          "items": false
        },
        "observed_vector_output": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "severity", "area", "summary", "evidence", "suggested_disposition"],
      "properties": {
        "id": { "type": "string", "pattern": "^AAC-REVIEW-[0-9]{3}$" },
        "severity": { "enum": ["info", "low", "medium", "high", "critical"] },
        "area": {
          "enum": [
            "canonicalization",
            "signature-and-hash-binding",
            "schema",
            "profile",
            "verdict-recomputation",
            "evidence-binding",
            "privacy",
            "threat-model",
            "documentation",
            "deployment"
          ]
        },
        "summary": { "type": "string", "minLength": 1 },
        "evidence": { "type": "string", "minLength": 1 },
        "suggested_disposition": {
          "enum": [
            "no-change",
            "documentation-clarification",
            "spec-change",
            "schema-change",
            "verifier-change",
            "test-or-vector-addition",
            "private-security-report"
          ]
        }
      }
    },
    "claim_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "independent_review_claimed",
        "endorsement_claimed",
        "legal_certification_claimed"
      ],
      "properties": {
        "independent_review_claimed": { "type": "boolean" },
        "endorsement_claimed": { "const": false },
        "legal_certification_claimed": { "const": false }
      }
    }
  }
}
